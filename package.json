{
  "name": "agent-computer",
  "version": "0.1.0",
  "description": "Give any coding agent its own Linux desktop (browser, Blender, office apps) via MCP, a CLI, or by running the agent inside it.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agent-computer": "skills/agent-computer/scripts/agent-computer.mjs"
  },
  "files": [
    "skills",
    ".claude-plugin"
  ],
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:skill": "npm run build && node scripts/pack-skill.mjs",
    "image": "docker build -t agent-computer:latest skills/agent-computer/docker"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.2"
  },
  "author": "Franco Alarcon <franco.alarcon@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoAA/agent-computer.git"
  },
  "homepage": "https://skills.sh/FrancoAA/agent-computer"
}
